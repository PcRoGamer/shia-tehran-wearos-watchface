<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_GOAL" value="8000" />

    <UserConfigurations>
        <!-- [0]=Night sky, [1]=Gold accent, [2]=Ivory text, [3]=Day sky -->
        <ColorConfiguration id="theme_color" displayName="theme_config_name" defaultValue="turquoise">
            <ColorOption id="turquoise" displayName="theme_turquoise" colors="#FF051E2B #FFF4C44E #FFFFFDF7 #FF0D5C75" />
            <ColorOption id="emerald" displayName="theme_emerald" colors="#FF041C16 #FFF5C756 #FFFFFDF7 #FF0C5942" />
            <ColorOption id="lapis" displayName="theme_lapis" colors="#FF071130 #FFF7D060 #FFFFFDF7 #FF184094" />
            <ColorOption id="ruby" displayName="theme_ruby" colors="#FF240711 #FFF6C358 #FFFFFDF7 #FF73172E" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#000000">
        <Group name="active_sky" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Rectangle x="0" y="0" width="450" height="450">
                    <Fill color="[CONFIGURATION.theme_color.0]" />
                </Rectangle>
            </PartDraw>
            <PartDraw x="0" y="0" width="450" height="450" alpha="0">
                <Transform target="alpha" value="[HOUR_0_23] &gt;= 6 &amp;&amp; [HOUR_0_23] &lt; 18 ? 255 : 0" />
                <Rectangle x="0" y="0" width="450" height="450">
                    <Fill color="[CONFIGURATION.theme_color.3]" />
                </Rectangle>
            </PartDraw>
            <PartImage x="0" y="0" width="450" height="450" alpha="0">
                <Transform target="alpha" value="[HOUR_0_23] &gt;= 6 &amp;&amp; [HOUR_0_23] &lt; 18 ? 0 : 220" />
                <Image resource="stars" />
            </PartImage>
            <PartImage name="night_sky_glow" x="0" y="0" width="510" height="510" alpha="0">
                <Transform target="alpha" value="!([HOUR_0_23] &gt;= 6 &amp;&amp; [HOUR_0_23] &lt; 18) ? 255 : 0" />
                <Transform target="x" value="-183 + ((([HOUR_0_23] &gt;= 18 ? [HOUR_0_23] - 18 : [HOUR_0_23] + 6) + [MINUTE] / 60.0) / 12.0) * 306" />
                <Transform target="y" value="-57 - 117 * sin(((([HOUR_0_23] &gt;= 18 ? [HOUR_0_23] - 18 : [HOUR_0_23] + 6) + [MINUTE] / 60.0) / 12.0) * 3.14159265)" />
                <Image resource="night_glow" />
            </PartImage>
            <PartImage name="sun_corona" x="0" y="0" width="300" height="300" alpha="0">
                <Transform target="alpha" value="[HOUR_0_23] &gt;= 6 &amp;&amp; [HOUR_0_23] &lt; 18 ? 255 : 0" />
                <Transform target="x" value="-78 + ((([HOUR_0_23] - 6) + [MINUTE] / 60.0) / 12.0) * 306" />
                <Transform target="y" value="48 - 117 * sin(((([HOUR_0_23] - 6) + [MINUTE] / 60.0) / 12.0) * 3.14159265)" />
                <Image resource="sun_glow" />
            </PartImage>
            <Group name="moon" x="0" y="0" width="240" height="240" alpha="0">
                <Transform target="alpha" value="[HOUR_0_23] &gt;= 6 &amp;&amp; [HOUR_0_23] &lt; 18 ? 0 : 255" />
                <Transform target="x" value="-48 + ((([HOUR_0_23] &gt;= 18 ? [HOUR_0_23] - 18 : [HOUR_0_23] + 6) + [MINUTE] / 60.0) / 12.0) * 306" />
                <Transform target="y" value="78 - 117 * sin(((([HOUR_0_23] &gt;= 18 ? [HOUR_0_23] - 18 : [HOUR_0_23] + 6) + [MINUTE] / 60.0) / 12.0) * 3.14159265)" />
                <PartImage x="0" y="0" width="240" height="240" alpha="0">
                    <Transform target="alpha" value="[MOON_PHASE_TYPE] == 0 ? 255 : 0" />
                    <Image resource="moon_0" />
                </PartImage>
                <PartImage x="0" y="0" width="240" height="240" alpha="0">
