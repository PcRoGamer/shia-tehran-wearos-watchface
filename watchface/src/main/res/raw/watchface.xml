<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_GOAL" value="8000" />

    <UserConfigurations>
        <!-- [0]=Deep Base, [1]=Gold Accent, [2]=Crisp Ivory, [3]=Blur Mesh Glow, [4]=Borderless Glass Fill -->
        <ColorConfiguration id="theme_color" displayName="theme_config_name" defaultValue="turquoise">
            <ColorOption id="turquoise" displayName="theme_turquoise" colors="#FF062C36 #FFF4C44E #FFFFFDF7 #FF14B8C4 #24FFFFFF" />
            <ColorOption id="emerald" displayName="theme_emerald" colors="#FF05291E #FFF5C756 #FFF7FDF9 #FF10B981 #24FFFFFF" />
            <ColorOption id="lapis" displayName="theme_lapis" colors="#FF0B1942 #FFF7D060 #FFF4F8FF #FF3B82F6 #24FFFFFF" />
            <ColorOption id="ruby" displayName="theme_ruby" colors="#FF360914 #FFF6C358 #FFFFF4EE #FFF43F5E #24FFFFFF" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="[CONFIGURATION.theme_color.0]">

        <!-- 1. Atmospheric Gaussian-Blurred Mesh Background -->
        <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.theme_color.3]">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="mesh_blur" />
        </PartImage>

        <!-- 2. Time-Linked Sun (Daytime 06:00 - 18:00) -->
        <PartImage x="135" y="24" width="180" height="180" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="([HOUR_0_23] &gt;= 6 &amp;&amp; [HOUR_0_23] &lt; 18) ? 235 : 0" />
            <Transform target="x" value="25 + (([HOUR_0_23] - 6) + [MINUTE] / 60.0) / 12 * 220" />
            <Transform target="y" value="110 - 95 * sin((([HOUR_0_23] - 6) + [MINUTE] / 60.0) / 12 * 3.14159)" />
            <Image resource="sun_glow" />
        </PartImage>

        <!-- 3. Time-Linked Atmospheric Glowing Moon (Nighttime 18:00 - 06:00) -->
        <Group name="moon_container" x="115" y="10" width="220" height="220" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="([HOUR_0_23] &gt;= 18 || [HOUR_0_23] &lt; 6) ? 235 : 0" />
            <Transform target="x" value="5 + ((([HOUR_0_23] &gt;= 18 ? [HOUR_0_23] - 18 : [HOUR_0_23] + 6) + [MINUTE] / 60.0) / 12) * 220" />
            <Transform target="y" value="95 - 95 * sin(((([HOUR_0_23] &gt;= 18 ? [HOUR_0_23] - 18 : [HOUR_0_23] + 6) + [MINUTE] / 60.0) / 12) * 3.14159)" />

            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 0 ? 255 : 0" />
                <Image resource="moon_0" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 1 ? 255 : 0" />
                <Image resource="moon_1" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 2 ? 255 : 0" />
                <Image resource="moon_2" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 3 ? 255 : 0" />
                <Image resource="moon_3" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 4 ? 255 : 0" />
                <Image resource="moon_4" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 5 ? 255 : 0" />
                <Image resource="moon_5" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 6 ? 255 : 0" />
                <Image resource="moon_6" />
            </PartImage>
            <PartImage x="0" y="0" width="220" height="220" alpha="0">
                <Transform target="alpha" value="[MOON_PHASE_TYPE] == 7 ? 255 : 0" />
                <Image resource="moon_7" />
            </PartImage>
        </Group>

        <!-- 4. Tapered Sweeping Second Hand BEHIND All UI & Bar Complications -->
        <AnalogClock x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <SecondHand resource="second_hand" x="215" y="0" width="20" height="450" pivotX="0.5" pivotY="0.5" tintColor="[CONFIGURATION.theme_color.1]">
                <Sweep frequency="15" />
            </SecondHand>
        </AnalogClock>

        <!-- 5. Curved Arc Bars Along the Outer Ring (4 Perimeter Complications) -->
        <PartDraw x="14" y="14" width="422" height="422">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Arc centerX="211" centerY="211" width="422" height="422" startAngle="298" endAngle="336" direction="CLOCKWISE"><Stroke color="#33FFFFFF" thickness="8" cap="ROUND" /></Arc>
            <Arc centerX="211" centerY="211" width="422" height="422" startAngle="24" endAngle="62" direction="CLOCKWISE"><Stroke color="#33FFFFFF" thickness="8" cap="ROUND" /></Arc>
            <Arc centerX="211" centerY="211" width="422" height="422" startAngle="204" endAngle="242" direction="CLOCKWISE"><Stroke color="#33FFFFFF" thickness="8" cap="ROUND" /></Arc>
            <Arc centerX="211" centerY="211" width="422" height="422" startAngle="118" endAngle="156" direction="CLOCKWISE"><Stroke color="#33FFFFFF" thickness="8" cap="ROUND" /></Arc>
        </PartDraw>

        <!-- Top-left arc: steps -->
        <ComplicationSlot x="14" y="14" width="422" height="422" slotId="7" displayName="slot_corner_tl" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="RANGED_VALUE" />
            <BoundingArc centerX="211" centerY="211" width="422" height="422" startAngle="298" endAngle="336" thickness="14" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="422" height="422">
                    <Arc centerX="211" centerY="211" width="422" height="422" startAngle="298" endAngle="298" direction="CLOCKWISE">
                        <Transform target="endAngle" value="298 + 38 * ([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="8" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="55" y="82" width="70" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Top-Right Arc Bar (Slot 5: Heart Rate) -->
        <ComplicationSlot x="14" y="14" width="422" height="422" slotId="5" displayName="slot_corner_tr" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="HEART_RATE" defaultSystemProviderType="RANGED_VALUE" />
            <BoundingArc centerX="211" centerY="211" width="422" height="422" startAngle="24" endAngle="62" thickness="14" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="422" height="422">
                    <Arc centerX="211" centerY="211" width="422" height="422" startAngle="24" endAngle="24" direction="CLOCKWISE">
                        <Transform target="endAngle" value="24 + 38 * ([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])" />
                        <Stroke color="#FFFB7185" thickness="8" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="297" y="82" width="70" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom-left arc: date -->
        <ComplicationSlot x="14" y="14" width="422" height="422" slotId="6" displayName="slot_corner_bl" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="DATE" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingArc centerX="211" centerY="211" width="422" height="422" startAngle="204" endAngle="242" thickness="14" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="422" height="422">
                    <Arc centerX="211" centerY="211" width="422" height="422" startAngle="204" endAngle="204" direction="CLOCKWISE">
                        <Transform target="endAngle" value="204 + 38 * ([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])" />
                        <Stroke color="#FF38BDF8" thickness="8" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="55" y="316" width="70" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom-right arc: battery -->
        <ComplicationSlot x="14" y="14" width="422" height="422" slotId="4" displayName="slot_corner_br" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="RANGED_VALUE" />
            <BoundingArc centerX="211" centerY="211" width="422" height="422" startAngle="118" endAngle="156" thickness="14" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="422" height="422">
                    <Arc centerX="211" centerY="211" width="422" height="422" startAngle="118" endAngle="118" direction="CLOCKWISE">
                        <Transform target="endAngle" value="118 + 38 * ([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])" />
                        <Stroke color="#FF34D399" thickness="8" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="297" y="316" width="70" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 6. Center Foreground Stack -->
        <!-- Top Hijri Date Pill (Slot 1) -->
        <PartDraw x="115" y="34" width="220" height="32">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="220" height="32" cornerRadiusX="16" cornerRadiusY="16">
                <Fill color="[CONFIGURATION.theme_color.4]" />
            </RoundRectangle>
        </PartDraw>
        <ComplicationSlot
            x="115" y="34" width="220" height="32"
            slotId="1"
            displayName="slot_hijri_name"
            supportedTypes="SHORT_TEXT LONG_TEXT">
            <DefaultProviderPolicy
                defaultSystemProvider="DAY_AND_DATE"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.shia.tehranwatchface/com.shia.tehranwatchface.complications.HijriDateComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingRoundBox x="0" y="0" width="220" height="32" cornerRadius="16" />
            <Complication type="SHORT_TEXT">
                <PartText x="8" y="3" width="204" height="26"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.theme_color.1]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                <PartText x="8" y="3" width="204" height="26"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="[CONFIGURATION.theme_color.1]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Center 12-Hour Digital Clock -->
        <DigitalClock x="40" y="102" width="370" height="106">
            <TimeText format="h:mm" hourFormat="12" align="CENTER" x="0" y="0" width="310" height="106">
                <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" color="[CONFIGURATION.theme_color.2]" />
            </TimeText>
        </DigitalClock>
        <PartText x="334" y="150" width="58" height="34">
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="[CONFIGURATION.theme_color.1]">
                    <Template>%s<Parameter expression="[AMPM_STRING]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- FOCUSED Borderless Frosted-Glass Next Prayer Card (Slot 2) -->
        <PartDraw x="68" y="234" width="314" height="78">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="314" height="78" cornerRadiusX="22" cornerRadiusY="22">
                <Fill color="[CONFIGURATION.theme_color.4]" />
            </RoundRectangle>
        </PartDraw>
        <ComplicationSlot
            x="68" y="234" width="314" height="78"
            slotId="2"
            displayName="slot_next_prayer_name"
            supportedTypes="LONG_TEXT SHORT_TEXT">
            <DefaultProviderPolicy
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="LONG_TEXT"
                primaryProvider="com.shia.tehranwatchface/com.shia.tehranwatchface.complications.NextPrayerComplicationService"
                primaryProviderType="LONG_TEXT" />
            <BoundingRoundBox x="0" y="0" width="314" height="78" cornerRadius="22" />
            <Complication type="LONG_TEXT">
                <PartText x="12" y="8" width="290" height="30"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="[CONFIGURATION.theme_color.1]"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text></PartText>
                <PartText x="12" y="42" width="290" height="26"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="[CONFIGURATION.theme_color.2]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="12" y="8" width="290" height="28"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="[CONFIGURATION.theme_color.1]"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text></PartText>
                <PartText x="12" y="40" width="290" height="28"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="[CONFIGURATION.theme_color.2]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
            </Complication>
        </ComplicationSlot>

        <!-- UNFOCUSED Secondary Row Below (Slot 3): Prayer After Next -->
        <ComplicationSlot
            x="95" y="320" width="260" height="28"
            slotId="3"
            displayName="slot_schedule_name"
            supportedTypes="LONG_TEXT SHORT_TEXT">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.shia.tehranwatchface/com.shia.tehranwatchface.complications.DailyScheduleComplicationService"
                primaryProviderType="LONG_TEXT" />
            <BoundingBox x="0" y="0" width="260" height="28" />
            <Complication type="LONG_TEXT">
                <PartText x="0" y="2" width="260" height="24" alpha="170"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="13.5" weight="NORMAL" color="[CONFIGURATION.theme_color.2]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="2" width="260" height="24" alpha="170"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="13.5" weight="NORMAL" color="[CONFIGURATION.theme_color.2]"><Template>%s • %s<Parameter expression="[COMPLICATION.TITLE]" /><Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
            </Complication>
        </ComplicationSlot>

    </Scene>
</WatchFace>
